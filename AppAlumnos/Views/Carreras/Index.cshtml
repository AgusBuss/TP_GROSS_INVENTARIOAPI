@model IEnumerable<AppAlumnos.Models.Carrera>

@{
    ViewData["Title"] = "Gestión de Carreras";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Carreras</h2>
    <button type="button" class="btn btn-primary" onclick="abrirModal('@Url.Action("ObtenerFormulario", "Carreras", new { id = 0 })')">
        + Nueva Carrera
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.DuracionAnios)</th>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">@item.Nombre</td>
                        <td class="align-middle">@item.DuracionAnios años</td>
                        <td class="align-middle">@(item.Descripcion ?? "—")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                            <button class="btn btn-sm btn-outline-warning me-1" onclick="abrirModal('@Url.Action("ObtenerFormulario", "Carreras", new { id = item.Id })')">
                                Editar
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="eliminarCarrera(@item.Id, '@item.Nombre')">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Contenedor del Modal Bootstrap -->
<div class="modal fade" id="modalCarrera" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalContentCarrera">
            <!-- La parcial se cargará aquí vía AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const modalElementCarrera = new bootstrap.Modal(document.getElementById('modalCarrera'));
        const modalContentCarrera = document.getElementById('modalContentCarrera');

        function abrirModal(url) {
            fetch(url)
                .then(res => res.text())
                .then(html => {
                    modalContentCarrera.innerHTML = html;
                    $.validator.unobtrusive.parse('#formCarrera');
                    modalElementCarrera.show();
                });
        }

        function guardarCarrera(event) {
            event.preventDefault();
            const form = event.target;
            if (!$(form).valid()) return;

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
                .then(res => {
                    if (res.headers.get("content-type").includes("application/json")) {
                        return res.json().then(data => {
                            if (data.success) {
                                modalElementCarrera.hide();
                                Swal.fire({
                                    title: '¡Listo!',
                                    text: data.mensaje,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            }
                        });
                    }
                    else {
                        return res.text().then(html => {
                            modalContentCarrera.innerHTML = html;
                            $.validator.unobtrusive.parse('#formCarrera');
                        });
                    }
                });
        }

        function eliminarCarrera(id, nombre) {
            Swal.fire({
                title: '¿Eliminar carrera?',
                text: `Estás por eliminar "${nombre}". Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const formData = new FormData();
                    formData.append('id', id);
                    if (token) formData.append('__RequestVerificationToken', token);

                    fetch('@Url.Action("EliminarAsync", "Carreras")', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => {
                            if (!res.ok) {
                                throw new Error(`Error del servidor (${res.status})`);
                            }
                            return res.json();
                        })
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: '¡Eliminada!',
                                    text: data.mensaje,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('No se pudo eliminar', data.mensaje, 'error');
                            }
                        })
                        .catch(err => {
                            Swal.fire('Error inesperado', 'No se pudo completar la operación. Probá de nuevo o contactá al administrador.', 'error');
                            console.error(err);
                        });
                }
            });
        }
    </script>
}