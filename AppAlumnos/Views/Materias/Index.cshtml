@model IEnumerable<AppAlumnos.Models.Materia>

@{
    ViewData["Title"] = "Gestión de Materias";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Materias</h2>
    <button type="button" class="btn btn-primary" onclick="abrirModal('@Url.Action("ObtenerFormulario", "Materias", new { id = 0 })')">
        + Nueva Materia
    </button>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <select id="filtroCarrera" class="form-select" asp-items="ViewBag.CarrerasFiltro" onchange="filtrarMaterias()">
            <option value="">-- Todas las carreras --</option>
        </select>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.Anio)</th>
                    <th>Carrera</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="cuerpoTablaMaterias">
                <partial name="_TablaMateriasPartial" model="Model" />
            </tbody>
        </table>
    </div>
</div>

<!-- Contenedor del Modal Bootstrap -->
<div class="modal fade" id="modalMateria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalContent">
            <!-- La parcial se cargará aquí vía AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const modalElement = new bootstrap.Modal(document.getElementById('modalMateria'));
        const modalContent = document.getElementById('modalContent');

        function abrirModal(url) {
            fetch(url)
                .then(res => res.text())
                .then(html => {
                    modalContent.innerHTML = html;
                    $.validator.unobtrusive.parse('#formMateria');
                    modalElement.show();
                });
        }

        function guardarMateria(event) {
            event.preventDefault();
            const form = event.target;
            if (!$(form).valid()) return;

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
                .then(res => {
                    if (res.headers.get("content-type").includes("application/json")) {
                        return res.json().then(data => {
                            if (data.success) {
                                modalElement.hide();
                                Swal.fire({
                                    title: '¡Listo!',
                                    text: data.mensaje,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => filtrarMaterias());
                            }
                        });
                    }
                    else {
                        return res.text().then(html => {
                            modalContent.innerHTML = html;
                            $.validator.unobtrusive.parse('#formMateria');
                        });
                    }
                });
        }

        function eliminarMateria(id, nombre) {
            Swal.fire({
                title: '¿Eliminar materia?',
                text: `Estás por eliminar "${nombre}". Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const formData = new FormData();
                    formData.append('id', id);
                    if (token) formData.append('__RequestVerificationToken', token);

                    fetch('@Url.Action("EliminarAsync", "Materias")', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: '¡Eliminada!',
                                    text: data.mensaje,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => filtrarMaterias());
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        });
                }
            });
        }

        function filtrarMaterias() {
            const carreraId = document.getElementById('filtroCarrera').value;
            const url = '@Url.Action("FiltrarPorCarrera", "Materias")' + (carreraId ? `?carreraId=${carreraId}` : '');

            fetch(url)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('cuerpoTablaMaterias').innerHTML = html;
                });
        }
    </script>
}