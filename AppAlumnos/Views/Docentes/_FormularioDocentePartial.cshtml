@model AppAlumnos.Models.CrearDocenteViewModel

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">Nuevo Docente</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="formDocente" asp-action="Guardar" asp-controller="Docentes" method="post" onsubmit="guardarDocente(event)">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-floating mb-3">
            <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
            <label asp-for="Nombre"></label>
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Apellido" class="form-control" placeholder="Apellido" />
            <label asp-for="Apellido"></label>
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Dni" class="form-control" placeholder="DNI" />
            <label asp-for="Dni"></label>
            <span asp-validation-for="Dni" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Legajo" class="form-control" placeholder="Legajo" />
            <label asp-for="Legajo"></label>
            <span asp-validation-for="Legajo" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" placeholder="Email" />
            <label asp-for="Email"></label>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="new-password" />
            <label asp-for="Password"></label>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="ConfirmarPassword" class="form-control" placeholder="Confirmar contraseña" autocomplete="new-password" />
            <label asp-for="ConfirmarPassword"></label>
            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Registrar
        </button>
    </div>
</form>