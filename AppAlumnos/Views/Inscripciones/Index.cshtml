@model IEnumerable<AppAlumnos.Models.Inscripcion>

@{
    ViewData["Title"] = "Gestión de Inscripciones";
    bool esStaff = (bool)(ViewBag.EsStaff ?? false);
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@(esStaff ? "Gestión de Inscripciones" : "Mis Inscripciones")</h2>
    <button type="button" class="btn btn-primary" onclick="abrirModal('@Url.Action("ObtenerFormulario", "Inscripciones", new { id = 0 })')">
        + Nueva Inscripción
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    @if (esStaff)
                    {
                        <th>Alumno</th>
                    }
                    <th>Materia</th>
                    <th>Año Lectivo</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Nota</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (esStaff)
                        {
                            <td class="align-middle">@item.Alumno?.NombreCompleto</td>
                        }
                        <td class="align-middle">@item.Materia?.Nombre</td>
                        <td class="align-middle">@item.AnioLectivo</td>
                        <td class="align-middle">@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="align-middle">
                            <span class="badge bg-@(item.Estado == AppAlumnos.Models.EstadoInscripcion.Aprobada ? "success" : item.Estado == AppAlumnos.Models.EstadoInscripcion.Desaprobada ? "danger" : item.Estado == AppAlumnos.Models.EstadoInscripcion.Libre ? "secondary" : "warning")">
                                @item.Estado
                            </span>
                        </td>
                        <td class="align-middle">@(item.NotaFinal?.ToString("0.##") ?? "—")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-warning me-1" onclick="abrirModal('@Url.Action("ObtenerFormulario", "Inscripciones", new { id = item.Id })')">
                                Editar
                            </button>
                            @if (esStaff)
                            {
                                <button class="btn btn-sm btn-outline-danger" onclick="eliminarInscripcion(@item.Id)">
                                    Eliminar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Contenedor del Modal Bootstrap -->
<div class="modal fade" id="modalInscripcion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalContentInscripcion">
            <!-- La parcial se cargará aquí vía AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const modalElementInscripcion = new bootstrap.Modal(document.getElementById('modalInscripcion'));
        const modalContentInscripcion = document.getElementById('modalContentInscripcion');

        function abrirModal(url) {
            fetch(url)
                .then(res => {
                    if (!res.ok) throw new Error(`Error del servidor (${res.status})`);
                    return res.text();
                })
                .then(html => {
                    modalContentInscripcion.innerHTML = html;
                    $.validator.unobtrusive.parse('#formInscripcion');
                    modalElementInscripcion.show();
                })
                .catch(err => {
                    Swal.fire('Error', 'No se pudo abrir el formulario.', 'error');
                    console.error(err);
                });
        }

        function guardarInscripcion(event) {
            event.preventDefault();
            const form = event.target;
            if (!$(form).valid()) return;

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
                .then(res => {
                    if (res.headers.get("content-type")?.includes("application/json")) {
                        return res.json().then(data => {
                            if (data.success) {
                                modalElementInscripcion.hide();
                                Swal.fire({
                                    title: '¡Listo!',
                                    text: data.mensaje,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            }
                        });
                    }
                    else {
                        return res.text().then(html => {
                            modalContentInscripcion.innerHTML = html;
                            $.validator.unobtrusive.parse('#formInscripcion');
                        });
                    }
                })
                .catch(err => {
                    Swal.fire('Error inesperado', 'No se pudo guardar la inscripción.', 'error');
                    console.error(err);
                });
        }

        function eliminarInscripcion(id) {
            Swal.fire({
                title: '¿Eliminar inscripción?',
                text: 'Esta acción no se puede deshacer.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const formData = new FormData();
                    formData.append('id', id);
                    if (token) formData.append('__RequestVerificationToken', token);

                    fetch('@Url.Action("EliminarAsync", "Inscripciones")', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => {
                            if (!res.ok) throw new Error(`Error del servidor (${res.status})`);
                            return res.json();
                        })
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: '¡Eliminada!',
                                    text: data.mensaje,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => location.reload());
                            } else {
                                Swal.fire('No se pudo eliminar', data.mensaje, 'error');
                            }
                        })
                        .catch(err => {
                            Swal.fire('Error inesperado', 'No se pudo eliminar la inscripción.', 'error');
                            console.error(err);
                        });
                }
            });
        }
    </script>
}